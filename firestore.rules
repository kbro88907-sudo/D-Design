rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "kbro88907@gmail.com" ||
        request.auth.token.email == "admin@portfolio.com" ||
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isDesigner(designerId) {
      return isSignedIn() && request.auth.uid == designerId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Test doc for boot connection test
    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------------- PUBLIC COLLECTIONS ----------------
    // Packages, Services, Portfolio, Offers, Announcements, Testimonials, Policies, Prompts, Contact
    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /portfolio/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /policies/{policyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /prompts/{promptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contact/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- DESIGNER WORKERS ----------------
    match /designers/{designerId} {
      allow read: if isAdmin() || isDesigner(designerId);
      allow write: if isAdmin();
    }

    // ---------------- CLIENT ORDERS & TASKS ----------------
    match /tasks/{taskId} {
      allow create: if true;
      allow read: if isAdmin() || (
        isSignedIn() && resource.data.assignedDesignerId == request.auth.uid
      );
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.assignedDesignerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'deliverableUrl',
          'designerNotes',
          'updatedAt'
        ])
      );
      allow delete: if isAdmin();
    }
  }
}
